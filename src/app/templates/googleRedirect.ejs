<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connecting to Google — HealthCare</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #090d16;
      --card-bg: rgba(15, 23, 42, 0.75);
      --card-border: rgba(255, 255, 255, 0.1);
      --primary: #3b82f6;
      --primary-glow: rgba(59, 130, 246, 0.25);
      --emerald: #10b981;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --danger: #ef4444;
      --danger-bg: rgba(239, 68, 68, 0.12);
      --danger-border: rgba(239, 68, 68, 0.25);
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
    }

    /* Ambient Background Glow */
    .ambient-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }

    .ambient-circle-1 {
      position: absolute;
      top: 15%;
      left: 20%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
      filter: blur(60px);
      animation: float-slow 12s ease-in-out infinite alternate;
    }

    .ambient-circle-2 {
      position: absolute;
      bottom: 20%;
      right: 20%;
      width: 380px;
      height: 380px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
      filter: blur(60px);
      animation: float-slow 10s ease-in-out infinite alternate-reverse;
    }

    .grid-overlay {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    }

    /* Main Container Card */
    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 440px;
      background: var(--card-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 2.25rem 2rem;
      text-align: center;
      box-shadow: 
        0 20px 40px -15px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      animation: card-appear 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Brand Logo / Icons Group */
    .logo-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 1.75rem;
      position: relative;
    }

    .icon-badge {
      position: relative;
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
    }

    .icon-badge.pulse-effect::before {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 22px;
      background: var(--primary-glow);
      opacity: 0.8;
      animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      z-index: -1;
    }

    .connection-line {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .connection-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.25);
      animation: dot-glow 1.4s infinite ease-in-out;
    }
    .connection-dot:nth-child(2) { animation-delay: 0.2s; }
    .connection-dot:nth-child(3) { animation-delay: 0.4s; }

    .google-badge {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Headings */
    h1 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .subtitle {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 1.75rem;
    }

    /* ECG Wave Animation */
    .ecg-box {
      width: 100%;
      height: 48px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 1rem;
      margin-bottom: 1.5rem;
      overflow: hidden;
      position: relative;
    }

    .ecg-svg {
      width: 100%;
      height: 36px;
      stroke: var(--primary);
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.5));
    }

    .ecg-path {
      stroke-dasharray: 400;
      stroke-dashoffset: 400;
      animation: ecg-draw 2s linear infinite;
    }

    /* Progress Bar */
    .progress-bar-wrap {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 999px;
      overflow: hidden;
      position: relative;
      margin-bottom: 1.25rem;
    }

    .progress-bar-fill {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 40%;
      background: linear-gradient(90deg, #3b82f6, #10b981);
      border-radius: 999px;
      animation: indeterminate-progress 1.6s ease-in-out infinite;
      box-shadow: 0 0 12px rgba(59, 130, 246, 0.6);
    }

    /* Security Badge */
    .security-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.07);
    }

    .security-badge svg {
      color: var(--emerald);
      width: 14px;
      height: 14px;
    }

    /* Error View */
    .error-container {
      display: none;
      animation: card-appear 0.3s ease-out forwards;
    }

    .error-icon-box {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      color: var(--danger);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
    }

    .error-message-box {
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      color: #fca5a5;
      font-size: 0.825rem;
      line-height: 1.4;
      padding: 0.875rem 1rem;
      border-radius: 12px;
      margin-bottom: 1.5rem;
      text-align: left;
      word-break: break-word;
    }

    .btn-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.75rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      border-radius: 12px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
      border: none;
      box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
    }
    .btn-primary:hover {
      background: #2563eb;
      transform: translateY(-1px);
    }

    .btn-outline {
      background: rgba(255, 255, 255, 0.05);
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* Keyframe Animations */
    @keyframes card-appear {
      from {
        opacity: 0;
        transform: scale(0.96) translateY(8px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.95);
        opacity: 0.8;
      }
      50% {
        transform: scale(1.15);
        opacity: 0;
      }
      100% {
        transform: scale(0.95);
        opacity: 0;
      }
    }

    @keyframes dot-glow {
      0%, 100% {
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0.9);
      }
      50% {
        background: var(--primary);
        transform: scale(1.2);
      }
    }

    @keyframes ecg-draw {
      0% {
        stroke-dashoffset: 400;
      }
      100% {
        stroke-dashoffset: 0;
      }
    }

    @keyframes indeterminate-progress {
      0% {
        left: -40%;
        width: 30%;
      }
      50% {
        left: 35%;
        width: 50%;
      }
      100% {
        left: 100%;
        width: 30%;
      }
    }

    @keyframes float-slow {
      0% {
        transform: translate(0, 0);
      }
      100% {
        transform: translate(30px, 20px);
      }
    }
  </style>
</head>
<body>
  <!-- Ambient glow backdrop -->
  <div class="ambient-bg">
    <div class="ambient-circle-1"></div>
    <div class="ambient-circle-2"></div>
    <div class="grid-overlay"></div>
  </div>

  <!-- Loading Card View -->
  <main class="card" id="loading-card">
    <div class="logo-container">
      <div class="icon-badge pulse-effect" title="HealthCare Portal">
        <!-- Medical HeartPulse SVG -->
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          <path d="M12 5 9.04 11l-2.08-3-2.96 6H2"/>
        </svg>
      </div>

      <div class="connection-line">
        <span class="connection-dot"></span>
        <span class="connection-dot"></span>
        <span class="connection-dot"></span>
      </div>

      <div class="google-badge" title="Google Authentication">
        <!-- Google Multi-Color Brand SVG -->
        <svg width="24" height="24" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.35 24 12 24Z"/>
          <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.42l4.03-3.15Z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
        </svg>
      </div>
    </div>

    <h1 id="status-title">Connecting to Google</h1>
    <p class="subtitle" id="status-subtitle">Establishing a secure session with Google Authentication...</p>

    <!-- Medical ECG Pulse Monitor Line -->
    <div class="ecg-box">
      <svg class="ecg-svg" viewBox="0 0 200 40">
        <path class="ecg-path" d="M0,20 L40,20 L48,10 L54,32 L60,4 L68,26 L74,20 L120,20 L128,10 L134,32 L140,4 L148,26 L154,20 L200,20" />
      </svg>
    </div>

    <!-- Animated Progress Bar -->
    <div class="progress-bar-wrap">
      <div class="progress-bar-fill"></div>
    </div>

    <!-- Security indicator -->
    <div class="security-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>256-Bit Encrypted Healthcare Gateway</span>
    </div>
  </main>

  <!-- Error Card View (Hidden by default) -->
  <section class="card error-container" id="error-card" aria-live="assertive">
    <div class="error-icon-box">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" x2="12" y1="8" y2="12"/>
        <line x1="12" x2="12.01" y1="16" y2="16"/>
      </svg>
    </div>

    <h1>Authentication Error</h1>
    <p class="subtitle">Unable to initiate Google sign-in session.</p>

    <div class="error-message-box" id="error-text">
      An unexpected error occurred while communicating with the authentication service.
    </div>

    <div class="btn-group">
      <button class="btn btn-primary" id="retry-btn" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
          <path d="M21 3v5h-5"/>
          <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
          <path d="M8 16H3v5"/>
        </svg>
        Try Again
      </button>

      <a class="btn btn-outline" href="<%= frontendUrl %>/login" id="return-login-link">
        Return to Login
      </a>
    </div>
  </section>

  <script>
    (async function initiateGoogleAuth() {
      const loadingCard = document.getElementById("loading-card");
      const errorCard = document.getElementById("error-card");
      const errorText = document.getElementById("error-text");
      const statusSubtitle = document.getElementById("status-subtitle");
      const retryBtn = document.getElementById("retry-btn");

      function showError(message) {
        if (loadingCard) loadingCard.style.display = "none";
        if (errorCard) errorCard.style.display = "block";
        if (errorText) errorText.textContent = message;
      }

      async function startOAuthFlow() {
        if (loadingCard) loadingCard.style.display = "block";
        if (errorCard) errorCard.style.display = "none";
        if (statusSubtitle) statusSubtitle.textContent = "Negotiating with Google Authentication servers...";

        try {
          const response = await fetch("<%= betterAuthUrl %>/api/auth/sign-in/social", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            credentials: "include",
            body: JSON.stringify({
              provider: "google",
              callbackURL: "<%= callbackURL %>"
            })
          });

          const data = await response.json();

          if (data && data.url) {
            if (statusSubtitle) statusSubtitle.textContent = "Redirecting to Google Accounts...";
            window.location.href = data.url;
          } else {
            const msg = data?.message || data?.error || "Failed to retrieve Google login URL.";
            showError(msg);
          }
        } catch (error) {
          showError(error?.message || "Network error. Please verify your connection.");
        }
      }

      if (retryBtn) {
        retryBtn.addEventListener("click", () => {
          startOAuthFlow();
        });
      }

      // Automatically start on load
      startOAuthFlow();
    })();
  </script>
</body>
</html>