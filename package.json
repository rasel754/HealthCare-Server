{
  "name": "HealthCare-Server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "build": "prisma generate && esbuild src/app.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external && tsc",
    "vercel-build": "prisma generate && esbuild src/app.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external && tsc",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . /src/**/*",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "push": "prisma db push",
    "pull": "prisma db pull",
    "generate": "prisma generate",
    "stripe:webhook": "stripe listen --forward-to localhost:5000/webhook"
  },
  "author": "<raselahmed73614@gmail.com>",
  "license": "MIT",
